#!/usr/bin/env python3
"""Manage demo site activation, lifecycle metadata and expiry."""

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


SITES_DIR = Path({{ demo_platform_sites_dir | to_json }})
DOMAIN = {{ demo_platform_domain | to_json }}
RETENTION_DAYS = {{ demo_platform_cleanup_retention_days | int }}
SLUG_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")
VALID_STATUSES = {"active", "inactive", "sold", "lost", "expired"}


def now_utc():
    return datetime.now(timezone.utc)


def parse_time(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def format_time(value):
    return value.astimezone(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def validate_slug(slug):
    if not SLUG_RE.fullmatch(slug):
        raise ValueError(f"Invalid demo slug: {slug}")


def site_dir(slug):
    validate_slug(slug)
    return SITES_DIR / slug


def metadata_path(slug):
    return site_dir(slug) / "metadata.json"


def load_metadata(slug):
    path = metadata_path(slug)
    if not path.is_file():
        raise FileNotFoundError(f"No deployed demo named {slug}")
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def write_metadata(slug, data):
    destination = metadata_path(slug)
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=destination.parent, delete=False
    ) as handle:
        json.dump(data, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
        temporary = Path(handle.name)
    temporary.chmod(0o644)
    os.replace(temporary, destination)


def set_current(slug, release_id):
    directory = site_dir(slug)
    release = directory / "releases" / release_id
    if not release.is_dir():
        raise FileNotFoundError(f"Release does not exist: {release}")
    temporary = directory / ".current.new"
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(Path("releases") / release_id)
    os.replace(temporary, directory / "current")


def disable_current(slug):
    current = site_dir(slug) / "current"
    if current.is_symlink() or current.is_file():
        current.unlink()


def deploy(args):
    directory = site_dir(args.slug)
    release = directory / "releases" / args.release_id
    if not release.is_dir():
        raise FileNotFoundError(f"Uploaded release does not exist: {release}")

    try:
        previous = load_metadata(args.slug)
    except FileNotFoundError:
        previous = {}

    deployed_at = now_utc()
    expires_at = parse_time(args.expires_at)
    data = {
        "slug": args.slug,
        "url": f"https://{args.slug}.{DOMAIN}",
        "status": "active",
        "created_at": previous.get("created_at", format_time(deployed_at)),
        "deployed_at": format_time(deployed_at),
        "expires_at": format_time(expires_at),
        "release_id": args.release_id,
        "source_repo": args.source_repo,
    }
    write_metadata(args.slug, data)
    set_current(args.slug, args.release_id)
    print(data["url"])


def status(args):
    if args.status not in VALID_STATUSES:
        raise ValueError(f"Unsupported status: {args.status}")
    data = load_metadata(args.slug)
    if args.status == "active":
        if parse_time(data["expires_at"]) <= now_utc():
            raise ValueError("Expired demo must be redeployed to become active")
        set_current(args.slug, data["release_id"])
    else:
        disable_current(args.slug)
    data["status"] = args.status
    data["status_updated_at"] = format_time(now_utc())
    write_metadata(args.slug, data)
    print(f"{args.slug}: {args.status}")


def cleanup(_args):
    now = now_utc()
    expired = []
    removed = []
    if not SITES_DIR.exists():
        return

    for directory in sorted(SITES_DIR.iterdir()):
        if not directory.is_dir() or not SLUG_RE.fullmatch(directory.name):
            continue
        try:
            data = load_metadata(directory.name)
            if data.get("status") == "active" and parse_time(data["expires_at"]) <= now:
                disable_current(directory.name)
                data["status"] = "expired"
                data["status_updated_at"] = format_time(now)
                write_metadata(directory.name, data)
                expired.append(directory.name)

            if data.get("status") != "active":
                changed = data.get("status_updated_at", data.get("expires_at"))
                if changed and (now - parse_time(changed)).days >= RETENTION_DAYS:
                    releases = directory / "releases"
                    if releases.exists():
                        shutil.rmtree(releases)
                        removed.append(directory.name)
        except (FileNotFoundError, ValueError, json.JSONDecodeError) as error:
            print(f"Skipping {directory}: {error}", file=sys.stderr)

    print(f"expired={len(expired)} releases_removed={len(removed)}")


def list_sites(_args):
    if not SITES_DIR.exists():
        return
    for directory in sorted(SITES_DIR.iterdir()):
        if not directory.is_dir() or not SLUG_RE.fullmatch(directory.name):
            continue
        try:
            data = load_metadata(directory.name)
            print(
                f"{data['slug']:<32} {data['status']:<10} "
                f"{data['expires_at']:<20} {data['url']}"
            )
        except (FileNotFoundError, ValueError, json.JSONDecodeError) as error:
            print(f"{directory.name:<32} invalid    {error}")


def parser():
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="command", required=True)

    deploy_parser = commands.add_parser("deploy")
    deploy_parser.add_argument("slug")
    deploy_parser.add_argument("release_id")
    deploy_parser.add_argument("expires_at")
    deploy_parser.add_argument("source_repo", nargs="?", default="")
    deploy_parser.set_defaults(handler=deploy)

    status_parser = commands.add_parser("status")
    status_parser.add_argument("slug")
    status_parser.add_argument("status", choices=sorted(VALID_STATUSES))
    status_parser.set_defaults(handler=status)

    cleanup_parser = commands.add_parser("cleanup")
    cleanup_parser.set_defaults(handler=cleanup)

    list_parser = commands.add_parser("list")
    list_parser.set_defaults(handler=list_sites)
    return root


def main():
    args = parser().parse_args()
    try:
        args.handler(args)
    except (FileNotFoundError, ValueError, PermissionError) as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
