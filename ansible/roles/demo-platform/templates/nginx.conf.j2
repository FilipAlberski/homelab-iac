user nginx;
worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;

    map $host $demo_slug {
        default "";
        ~^(?<slug>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.{{ demo_platform_domain | replace('.', '\\.') }}$ $slug;
    }

    server {
        listen 8080 default_server;
        root /srv/demos/$demo_slug/current;
        index index.html;
        autoindex off;

        location = /_health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /robots.txt {
            default_type text/plain;
            add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
            return 200 "User-agent: *\nDisallow: /\n";
        }

        location ~ /\. {
            deny all;
        }

        location / {
            limit_except GET HEAD { deny all; }
            try_files $uri $uri/ /index.html =404;

            sub_filter_once on;
            sub_filter '</body>' '<div role="note" style="position:fixed;z-index:2147483647;right:12px;bottom:12px;max-width:calc(100vw - 24px);padding:8px 12px;border-radius:999px;background:rgba(17,24,39,.92);color:#fff;font:600 12px/1.35 system-ui,sans-serif;box-shadow:0 4px 18px rgba(0,0,0,.24)">Projekt demonstracyjny — nieoficjalna koncepcja strony.</div></body>';
        }

        error_page 404 =404 /_demo_unavailable;
        location = /_demo_unavailable {
            internal;
            root /usr/share/nginx/system-pages;
            try_files /unavailable.html =404;
        }
    }
}
