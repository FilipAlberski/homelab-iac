---
http:
  routers:
    traefik:
      rule: Host(`traefik.lab`)
      service: api@internal
      entryPoints:
        - web

    kuma:
      rule: Host(`kuma.lab`)
      service: kuma
      entryPoints:
        - web

    homepage:
      rule: Host(`homepage.lab`)
      service: homepage
      entryPoints:
        - web

    paperless:
      rule: Host(`paperless.lab`)
      service: paperless
      entryPoints:
        - web

    portainer:
      rule: Host(`portainer.lab`)
      service: portainer
      entryPoints:
        - web

    seafile:
      rule: Host(`seafile.lab`)
      service: seafile
      entryPoints:
        - web

    jellyfin:
      rule: Host(`jellyfin.lab`)
      service: jellyfin
      entryPoints:
        - web

    seerr:
      rule: Host(`seerr.lab`)
      service: seerr
      entryPoints:
        - web

    actual:
      rule: Host(`actual.lab`)
      service: actual
      entryPoints:
        - web
        - websecure
      tls: {}
      middlewares:
        - actual-headers

    grafana:
      rule: Host(`grafana.lab`)
      service: grafana
      entryPoints:
        - web

    prometheus:
      rule: Host(`prometheus.lab`)
      service: prometheus
      entryPoints:
        - web

    alertmanager:
      rule: Host(`alertmanager.lab`)
      service: alertmanager
      entryPoints:
        - web

    loki:
      rule: Host(`loki.lab`)
      service: loki
      entryPoints:
        - web

  middlewares:
    actual-headers:
      headers:
        customResponseHeaders:
          Cross-Origin-Opener-Policy: same-origin
          Cross-Origin-Embedder-Policy: require-corp

  services:
    kuma:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['app-01']['ansible_host'] | default('192.168.40.143') }}:3001"

    homepage:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['app-01']['ansible_host'] | default('192.168.40.143') }}:3000"

    paperless:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['app-01']['ansible_host'] | default('192.168.40.143') }}:8001"

    portainer:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['app-01']['ansible_host'] | default('192.168.40.143') }}:8000"

    seafile:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['app-01']['ansible_host'] | default('192.168.40.143') }}:8002"

    jellyfin:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.40.131') }}:8096"

    seerr:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.40.131') }}:5055"

    actual:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['app-01']['ansible_host'] | default('192.168.40.143') }}:5006"

    grafana:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.40.144') }}:3000"

    prometheus:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.40.144') }}:9090"

    alertmanager:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.40.144') }}:9093"

    loki:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.40.144') }}:3100"

tls:
  certificates:
    - certFile: /certs/cert.pem
      keyFile: /certs/key.pem
