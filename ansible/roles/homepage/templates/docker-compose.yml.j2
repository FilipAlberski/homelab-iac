---
services:
  homepage:
    container_name: homepage
    image: "{{ homepage_image }}"
    restart: unless-stopped
    ports:
      - "{{ homepage_port }}:3000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./config:/app/config
    environment:
      TZ: "{{ homelab_timezone }}"
      HOMEPAGE_ALLOWED_HOSTS: "homepage.{{ homelab_domain }},localhost,127.0.0.1,{{ ansible_host }}"
