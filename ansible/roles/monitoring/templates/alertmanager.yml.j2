---
global:
  resolve_timeout: 5m

route:
  receiver: "{{ 'telegram' if monitoring_telegram_enabled | default(false) | bool else 'default' }}"
  group_by:
    - alertname
    - instance
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: default

{% if monitoring_telegram_enabled | default(false) | bool %}
  - name: telegram
    telegram_configs:
      - api_url: "{{ monitoring_telegram_api_url }}"
        bot_token: "{{ monitoring_telegram_bot_token }}"
        chat_id: {{ monitoring_telegram_chat_id }}
        parse_mode: "{{ monitoring_telegram_parse_mode }}"
        send_resolved: {{ monitoring_telegram_send_resolved | bool | lower }}
        message: |-
          {% raw %}{{ range .Alerts -}}
          <b>[{{ .Status | toUpper }}] {{ .Labels.alertname }}</b>
          {{- if .Labels.severity }}
          <b>Severity:</b> {{ .Labels.severity }}
          {{- end }}
          {{- if .Labels.instance }}
          <b>Host:</b> {{ .Labels.instance }}
          {{- end }}
          {{- if .Annotations.summary }}
          <b>Summary:</b> {{ .Annotations.summary }}
          {{- end }}
          {{- if .Annotations.description }}
          <b>Description:</b> {{ .Annotations.description }}
          {{- end }}

          {{ end }}{% endraw %}
{% endif %}
