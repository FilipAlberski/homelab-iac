---
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: grafana
    static_configs:
      - targets:
          - grafana:3000

  - job_name: loki
    static_configs:
      - targets:
          - loki:3100

  - job_name: alertmanager
    static_configs:
      - targets:
          - alertmanager:9093

  - job_name: blackbox
    static_configs:
      - targets:
          - blackbox-exporter:9115

  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
      - targets:
          - http://{{ hostvars['dns-01']['ansible_host'] | default('192.168.60.141') }}/admin/
          - http://{{ hostvars['app-01']['ansible_host'] | default('192.168.60.143') }}:3001
          - http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:3000/login
          - http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:9090/-/ready
          - http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:9093/-/ready
          - http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:3100/ready
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:8096/health
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:5055/api/v1/settings/public
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:8989/ping
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:7878/ping
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:9696/ping
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:6767/
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:8080/
          - http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:9999/
          - http://192.168.60.147:8123/
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox_tcp
    metrics_path: /probe
    params:
      module:
        - tcp_connect
    static_configs:
      - targets:
          - {{ hostvars['proxy-01']['ansible_host'] | default('192.168.60.142') }}:80
          - {{ hostvars['proxy-01']['ansible_host'] | default('192.168.60.142') }}:443
          - {{ hostvars['dns-01']['ansible_host'] | default('192.168.60.141') }}:53
          - {{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:9090
          - {{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:9093
          - {{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:3100
          - {{ hostvars['games-01']['ansible_host'] | default('192.168.60.130') }}:26900
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox_icmp
    metrics_path: /probe
    params:
      module:
        - icmp
    static_configs:
      - targets:
          - 192.168.60.10
          - {{ hostvars['games-01']['ansible_host'] | default('192.168.60.130') }}
          - {{ hostvars['dns-01']['ansible_host'] | default('192.168.60.141') }}
          - {{ hostvars['proxy-01']['ansible_host'] | default('192.168.60.142') }}
          - {{ hostvars['app-01']['ansible_host'] | default('192.168.60.143') }}
          - {{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}
          - {{ hostvars['public-01']['ansible_host'] | default('192.168.60.145') }}
          - {{ hostvars['public-02']['ansible_host'] | default('192.168.60.146') }}
          - 192.168.60.147
          - {{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox_dns
    metrics_path: /probe
    params:
      module:
        - dns_udp
    static_configs:
      - targets:
          - {{ hostvars['dns-01']['ansible_host'] | default('192.168.60.141') }}
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
