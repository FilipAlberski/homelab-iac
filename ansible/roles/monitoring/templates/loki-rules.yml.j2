---
groups:
  - name: homelab-logs
    interval: 1m
    rules:
      - alert: ContainerLogErrorsHigh
        expr: sum by (host, container) (count_over_time({job="docker",host=~".*-01"} |~ "(?i)(error|fatal|panic|exception|failed)" !~ "(?i)(client version .* too old|timestamp too old|ingestion rate limit exceeded|empty ring|broken pipe|connection reset by peer|gossip not settled)" [30m])) > 100
        for: 10m
        labels:
          severity: warning
          instance: "{% raw %}{{ $labels.host }}{% endraw %}"
        annotations:
          summary: "High error log volume in {% raw %}{{ $labels.container }} on {{ $labels.host }}{% endraw %}"
          description: "More than 100 non-ignored error-like log lines were seen in 30 minutes."
