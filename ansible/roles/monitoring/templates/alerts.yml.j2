---
groups:
  - name: homelab-hosts
    rules:
      - alert: HostTelemetryStale
        expr: time() - max by (instance) (timestamp(node_uname_info{instance=~".*-01"})) > 300
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Host telemetry is stale for {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "No fresh Alloy/node metrics have been received for more than 5 minutes."

      - alert: HostExporterDown
        expr: up{job="node",instance=~".*-01"} == 0
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "Host exporter is down on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Alloy is reporting a failed node exporter scrape."

      - alert: HostDiskLowSpace
        expr: |
          (
            node_filesystem_avail_bytes{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}
            /
            node_filesystem_size_bytes{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}
          ) < 0.15
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space on {% raw %}{{ $labels.instance }}{% endraw %}: {% raw %}{{ $labels.mountpoint }}{% endraw %}"
          description: "Filesystem {% raw %}{{ $labels.mountpoint }}{% endraw %} has less than 15% free space."

      - alert: HostDiskCritical
        expr: |
          (
            node_filesystem_avail_bytes{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}
            /
            node_filesystem_size_bytes{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}
          ) < 0.05
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Disk almost full on {% raw %}{{ $labels.instance }}{% endraw %}: {% raw %}{{ $labels.mountpoint }}{% endraw %}"
          description: "Filesystem {% raw %}{{ $labels.mountpoint }}{% endraw %} has less than 5% free space."

      - alert: HostHighLoad
        expr: node_load1{instance=~".*-01"} / count without (cpu, mode) (node_cpu_seconds_total{instance=~".*-01",mode="idle"}) > 1.5
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High load on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "1-minute load average is more than 1.5x the CPU core count."

      - alert: HostRebooted
        expr: time() - node_boot_time_seconds{instance=~".*-01"} < 600
        for: 2m
        labels:
          severity: info
        annotations:
          summary: "Host recently rebooted: {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Host uptime is below 10 minutes."

      - alert: HostMemoryHigh
        expr: 1 - (node_memory_MemAvailable_bytes{instance=~".*-01"} / node_memory_MemTotal_bytes{instance=~".*-01"}) > 0.90
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Memory usage is above 90% for 15 minutes."

      - alert: HostDiskInodesLow
        expr: |
          (
            node_filesystem_files_free{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}
            /
            node_filesystem_files{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}
          ) < 0.10
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Low inode space on {% raw %}{{ $labels.instance }}{% endraw %}: {% raw %}{{ $labels.mountpoint }}{% endraw %}"
          description: "Filesystem {% raw %}{{ $labels.mountpoint }}{% endraw %} has less than 10% free inodes."

      - alert: HostDiskWillFillSoon
        expr: |
          predict_linear(
            node_filesystem_avail_bytes{instance=~".*-01",fstype!~"tmpfs|overlay|squashfs|ramfs|devtmpfs",mountpoint!~"/run.*|/var/lib/docker/.+"}[6h],
            7 * 24 * 3600
          ) < 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Disk may fill within 7 days on {% raw %}{{ $labels.instance }}{% endraw %}: {% raw %}{{ $labels.mountpoint }}{% endraw %}"
          description: "Filesystem {% raw %}{{ $labels.mountpoint }}{% endraw %} free-space trend predicts exhaustion within 7 days."

      - alert: HostUnreachable
        expr: probe_success{job="blackbox_icmp",instance=~"192\\.168\\.40\\.1[3-4][0-9]"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Host unreachable: {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "ICMP ping probe failed for 2 minutes. Host may be down or network interface dead."

      - alert: ProxmoxUnreachable
        expr: probe_success{job="blackbox_icmp",instance="192.168.60.10"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Proxmox host unreachable: 192.168.60.10"
          description: "ICMP ping probe failed for 2 minutes. Proxmox host may be down or network dead."

  - name: homelab-services
    rules:
      - alert: TraefikDown
        expr: probe_success{job="blackbox_tcp",instance=~"{{ hostvars['proxy-01']['ansible_host'] | default('192.168.60.142') }}:(80|443)"} == 0
        for: 2m
        labels:
          severity: critical
          host: proxy-01
        annotations:
          summary: "Traefik/proxy endpoint is down"
          description: "Blackbox probe failed for {% raw %}{{ $labels.instance }}{% endraw %}."

      - alert: PiholeDown
        expr: probe_success{job=~"blackbox_http|blackbox_tcp|blackbox_dns",instance=~"http://{{ hostvars['dns-01']['ansible_host'] | default('192.168.60.141') }}/admin/|{{ hostvars['dns-01']['ansible_host'] | default('192.168.60.141') }}(:53)?"} == 0
        for: 2m
        labels:
          severity: critical
          host: dns-01
        annotations:
          summary: "Pi-hole/DNS endpoint is down"
          description: "Blackbox probe failed for {% raw %}{{ $labels.instance }}{% endraw %}."

      - alert: MonitoringStackDown
        expr: probe_success{job=~"blackbox_http|blackbox_tcp",instance=~"http://{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:(3000/login|9090/-/ready|9093/-/ready|3100/ready)|{{ hostvars['monitoring-01']['ansible_host'] | default('192.168.60.144') }}:(9090|9093|3100)"} == 0
        for: 2m
        labels:
          severity: critical
          host: monitoring-01
        annotations:
          summary: "Monitoring endpoint is down"
          description: "Blackbox probe failed for {% raw %}{{ $labels.instance }}{% endraw %}."

      - alert: HomeAssistantDown
        expr: probe_success{job="blackbox_http",instance="http://192.168.60.147:8123/"} == 0
        for: 3m
        labels:
          severity: critical
          host: homeassistant-01
        annotations:
          summary: "Home Assistant is down"
          description: "Home Assistant did not answer on port 8123 for 3 minutes."

      - alert: SevenDaysToDieDown
        expr: probe_success{job="blackbox_tcp",instance=~"{{ hostvars['games-01']['ansible_host'] | default('192.168.60.130') }}:26900"} == 0
        for: 2m
        labels:
          severity: critical
          host: games-01
        annotations:
          summary: "7 Days to Die server is down on games-01"
          description: "Blackbox TCP probe failed for port 26900 on games-01. Server may be stopped or crashed."

      - alert: SevenDaysToDieRestarting
        expr: sum by (instance) (changes(container_last_seen{host="games-01",container="7dtdserver"}[5m])) > 1
        for: 1m
        labels:
          severity: warning
          host: games-01
        annotations:
          summary: "7 Days to Die container is restarting loop on games-01"
          description: "Container 7dtdserver restarted more than once in 5 minutes."

      - alert: MediaStackEndpointDown
        expr: probe_success{job="blackbox_http",instance=~"http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:(8096/health|5055/api/v1/settings/public|8989/ping|7878/ping|9696/ping|6767/|8080/)"} == 0
        for: 3m
        labels:
          severity: warning
          host: jelly-01
        annotations:
          summary: "Media stack endpoint is down"
          description: "Blackbox probe failed for {% raw %}{{ $labels.instance }}{% endraw %}."

      - alert: MediaVpnDown
        expr: probe_success{job="blackbox_http",instance="http://{{ hostvars['jelly-01']['ansible_host'] | default('192.168.60.131') }}:9999/"} == 0
        for: 2m
        labels:
          severity: critical
          host: jelly-01
        annotations:
          summary: "Gluetun VPN is unhealthy on jelly-01"
          description: "qBittorrent remains kill-switched until the Mullvad tunnel recovers."

      - alert: CloudflareTunnelDown
        expr: |
          cloudflared_tunnel_ha_connections{instance="public-01"} < 1
          or absent(cloudflared_tunnel_ha_connections{instance="public-01"})
        for: 2m
        labels:
          severity: critical
          host: public-01
        annotations:
          summary: "Cloudflare Tunnel is disconnected on public-01"
          description: "cloudflared has no active connection to the Cloudflare edge."

      - alert: DemoCloudflareTunnelDown
        expr: |
          cloudflared_tunnel_ha_connections{instance="public-02"} < 1
          or absent(cloudflared_tunnel_ha_connections{instance="public-02"})
        for: 2m
        labels:
          severity: critical
          host: public-02
        annotations:
          summary: "Demo Cloudflare Tunnel is disconnected on public-02"
          description: "The dedicated demo tunnel has no active connection to the Cloudflare edge."

      - alert: DemoTraefikDown
        expr: |
          up{job="demo-traefik",instance="public-02"} == 0
          or absent(up{job="demo-traefik",instance="public-02"})
        for: 2m
        labels:
          severity: critical
          host: public-02
        annotations:
          summary: "Demo Traefik is down on public-02"
          description: "Alloy cannot scrape the dedicated demo reverse proxy."

      - alert: DemoStaticBackendDown
        expr: |
          traefik_service_server_up{instance="public-02",service="demo-static@file"} == 0
          or absent(traefik_service_server_up{instance="public-02",service="demo-static@file"})
        for: 2m
        labels:
          severity: critical
          host: public-02
        annotations:
          summary: "Static demo backend is down on public-02"
          description: "Traefik reports that the shared Nginx demo backend is unavailable."
