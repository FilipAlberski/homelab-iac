name: monitoring

services:
  prometheus:
    image: {{ monitoring_prometheus_image }}
    container_name: prometheus
    restart: unless-stopped
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_prometheus_retention_time }}
      - --storage.tsdb.retention.size={{ monitoring_prometheus_retention_size }}
    volumes:
      - {{ monitoring_root }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ monitoring_root }}/prometheus/rules:/etc/prometheus/rules:ro
      - {{ monitoring_root }}/prometheus/data:/prometheus
    security_opt:
      - no-new-privileges:true

{% if monitoring_alertmanager_enabled | bool %}
  alertmanager:
    image: {{ monitoring_alertmanager_image }}
    container_name: alertmanager
    restart: unless-stopped
    network_mode: host
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=127.0.0.1:{{ monitoring_alertmanager_port }}
    volumes:
      - {{ monitoring_root }}/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - {{ monitoring_root }}/alertmanager/data:/alertmanager
    security_opt:
      - no-new-privileges:true
{% endif %}

  grafana:
    image: {{ monitoring_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    environment:
      TZ: {{ homelab_timezone }}
      GF_SERVER_HTTP_ADDR: 0.0.0.0
      GF_SERVER_HTTP_PORT: "{{ monitoring_grafana_port }}"
      GF_SERVER_DOMAIN: grafana.{{ homelab_domain }}
      GF_SERVER_ROOT_URL: http://grafana.{{ homelab_domain }}
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_SECURITY_ALLOW_EMBEDDING: "true"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
    volumes:
      - {{ monitoring_root }}/grafana/data:/var/lib/grafana
      - {{ monitoring_root }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_root }}/grafana/dashboards:/var/lib/grafana/dashboards:ro
    security_opt:
      - no-new-privileges:true

  blackbox-exporter:
    image: {{ monitoring_blackbox_image }}
    container_name: blackbox-exporter
    restart: unless-stopped
    network_mode: host
    dns:
      - {{ hostvars['dns-01']['ansible_host'] }}
      - 1.1.1.1
    dns_search:
      - {{ homelab_domain }}
    command:
      - --config.file=/etc/blackbox_exporter/blackbox.yml
    cap_add:
      - NET_RAW
    volumes:
      - {{ monitoring_root }}/blackbox/blackbox.yml:/etc/blackbox_exporter/blackbox.yml:ro
    security_opt:
      - no-new-privileges:true

{% if monitoring_pve_enabled | bool %}
  pve-exporter:
    image: {{ monitoring_pve_image }}
    container_name: pve-exporter
    restart: unless-stopped
    network_mode: host
    init: true
    env_file:
      - .env
    environment:
      PVE_USER: {{ monitoring_pve_user }}
      PVE_TOKEN_NAME: ${PVE_TOKEN_NAME}
      PVE_TOKEN_VALUE: ${PVE_TOKEN_VALUE}
      PVE_VERIFY_SSL: "{{ monitoring_pve_verify_ssl | bool | lower }}"
    security_opt:
      - no-new-privileges:true
{% endif %}

{% if monitoring_mikrotik_snmp_enabled | bool %}
  snmp-exporter:
    image: {{ monitoring_snmp_image }}
    container_name: snmp-exporter
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    command:
      - --config.file=/etc/snmp_exporter/snmp.yml
      - --config.file=/etc/snmp_exporter/auth.yml
      - --config.expand-environment-variables
    volumes:
      - {{ monitoring_root }}/snmp/auth.yml:/etc/snmp_exporter/auth.yml:ro
    security_opt:
      - no-new-privileges:true
{% endif %}

{% if monitoring_pihole_exporter_enabled | bool %}
  pihole-exporter:
    image: {{ monitoring_pihole_image }}
    container_name: pihole-exporter
    restart: unless-stopped
    network_mode: host
    env_file:
      - .env
    environment:
      PIHOLE_PROTOCOL: http
      PIHOLE_HOSTNAME: {{ hostvars['dns-01']['ansible_host'] }}
      PIHOLE_PORT: "80"
      PIHOLE_PASSWORD: ${PIHOLE_PASSWORD}
      PORT: "9617"
      INTERVAL: "30s"
    security_opt:
      - no-new-privileges:true
{% endif %}
