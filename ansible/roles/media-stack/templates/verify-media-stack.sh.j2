#!/usr/bin/env bash
set -Eeuo pipefail

cd {{ media_stack_dir | quote }}
# shellcheck disable=SC1091
source ./.verify.env

probe_source="{{ media_data_mount }}/torrents/movies/.hardlink-probe"
probe_target="{{ media_data_mount }}/media/movies/.hardlink-probe"
cookie_file="/tmp/media-stack-qbit-cookie.$$"
vpn_stopped=0

cleanup() {
  rm -f "${probe_source}" "${probe_target}" "${cookie_file}"
  if [[ "${vpn_stopped}" == "1" ]]; then
    docker compose up -d gluetun >/dev/null 2>&1 || true
    wait_for_health gluetun >/dev/null 2>&1 || true
    docker compose restart qbittorrent >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1" >&2; exit 1; }

wait_for_health() {
  local container="$1"
  local state
  for _ in $(seq 1 60); do
{% raw %}
    state=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "${container}" 2>/dev/null || true)
{% endraw %}
    if [[ "${state}" == "healthy" || "${state}" == "running" ]]; then
      return 0
    fi
    sleep 5
  done
  return 1
}

wait_for_qbittorrent_api() {
  local status
  for _ in $(seq 1 60); do
    status=$(curl -sS -o /dev/null -w '%{http_code}' \
      --cookie-jar "${cookie_file}" \
      --data-urlencode "username=${QBITTORRENT_ADMIN_USER}" \
      --data-urlencode "password=${QBITTORRENT_ADMIN_PASSWORD}" \
      "http://{{ media_host_ip }}:{{ media_ports.qbittorrent }}/api/v2/auth/login" 2>/dev/null || true)
    if [[ "${status}" == "200" || "${status}" == "204" ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_arr_download_client() {
  local port="$1"
  local api_key="$2"
  local payload="$3"
  for _ in $(seq 1 30); do
    if curl -fsS -X POST -H "X-Api-Key: ${api_key}" \
      -H 'Content-Type: application/json' --data "${payload}" \
      "http://{{ media_host_ip }}:${port}/api/v3/downloadclient/test" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

containers=(gluetun qbittorrent sonarr radarr prowlarr flaresolverr bazarr jellyfin seerr)
for container in "${containers[@]}"; do
  wait_for_health "${container}" || fail "container ${container} did not become healthy"
done
wait_for_qbittorrent_api || fail "qBittorrent API is not reachable through Gluetun"
pass "all media containers are running and healthy"

vpn_json=$(docker exec gluetun wget -qO- https://am.i.mullvad.net/json)
vpn_is_mullvad=$(python3 -c 'import json,sys; print(str(bool(json.loads(sys.argv[1]).get("mullvad_exit_ip"))).lower())' "${vpn_json}")
[[ "${vpn_is_mullvad}" == "true" ]] || fail "qBittorrent network namespace is not using a Mullvad exit"
pass "qBittorrent public IP belongs to Mullvad"

normal_ip=$(docker exec sonarr curl -fsS --max-time 15 https://api.ipify.org)
[[ -n "${normal_ip}" ]] || fail "Sonarr has no direct internet access"
pass "non-VPN applications have direct internet access"

docker stop gluetun >/dev/null
vpn_stopped=1
sleep 5
if docker exec qbittorrent curl -fsS --max-time 10 https://api.ipify.org >/dev/null 2>&1; then
  fail "qBittorrent retained internet access after Gluetun stopped"
fi
pass "qBittorrent loses internet access when Gluetun stops"

docker exec sonarr curl -fsS --max-time 15 https://api.ipify.org >/dev/null \
  || fail "Sonarr lost internet access when Gluetun stopped"
pass "other applications remain online while Gluetun is stopped"

docker compose up -d gluetun >/dev/null
wait_for_health gluetun || fail "Gluetun did not recover after kill-switch test"
docker compose restart qbittorrent >/dev/null
wait_for_health qbittorrent || fail "qBittorrent did not recover after kill-switch test"
wait_for_qbittorrent_api || fail "qBittorrent API did not recover after kill-switch test"
vpn_stopped=0
pass "VPN download path recovered cleanly"

printf 'hardlink probe\n' > "${probe_source}"
ln "${probe_source}" "${probe_target}"
source_inode=$(stat -c '%d:%i' "${probe_source}")
target_inode=$(stat -c '%d:%i' "${probe_target}")
[[ "${source_inode}" == "${target_inode}" ]] || fail "torrent and media paths cannot hardlink"
rm -f "${probe_source}" "${probe_target}"
pass "torrent and media trees share one filesystem and support hardlinks"

sonarr_key=$(sed -n 's:.*<ApiKey>\([^<]*\)</ApiKey>.*:\1:p' {{ media_stack_config_dir | quote }}/sonarr/config.xml)
radarr_key=$(sed -n 's:.*<ApiKey>\([^<]*\)</ApiKey>.*:\1:p' {{ media_stack_config_dir | quote }}/radarr/config.xml)
prowlarr_key=$(sed -n 's:.*<ApiKey>\([^<]*\)</ApiKey>.*:\1:p' {{ media_stack_config_dir | quote }}/prowlarr/config.xml)

sonarr_clients=$(curl -fsS -H "X-Api-Key: ${sonarr_key}" "http://{{ media_host_ip }}:{{ media_ports.sonarr }}/api/v3/downloadclient")
radarr_clients=$(curl -fsS -H "X-Api-Key: ${radarr_key}" "http://{{ media_host_ip }}:{{ media_ports.radarr }}/api/v3/downloadclient")
python3 -c 'import json,sys; c=next(x for x in json.loads(sys.argv[1]) if x["name"]=="qBittorrent"); assert any(f["name"]=="tvCategory" and f.get("value")=="tv" for f in c["fields"])' "${sonarr_clients}" \
  || fail "Sonarr qBittorrent category is not tv"
python3 -c 'import json,sys; c=next(x for x in json.loads(sys.argv[1]) if x["name"]=="qBittorrent"); assert any(f["name"]=="movieCategory" and f.get("value")=="movies" for f in c["fields"])' "${radarr_clients}" \
  || fail "Radarr qBittorrent category is not movies"
sonarr_qbittorrent=$(python3 -c 'import json,sys; print(json.dumps(next(x for x in json.loads(sys.argv[1]) if x["name"]=="qBittorrent")))' "${sonarr_clients}")
radarr_qbittorrent=$(python3 -c 'import json,sys; print(json.dumps(next(x for x in json.loads(sys.argv[1]) if x["name"]=="qBittorrent")))' "${radarr_clients}")
wait_for_arr_download_client {{ media_ports.sonarr }} "${sonarr_key}" "${sonarr_qbittorrent}" \
  || fail "Sonarr cannot authenticate to qBittorrent"
wait_for_arr_download_client {{ media_ports.radarr }} "${radarr_key}" "${radarr_qbittorrent}" \
  || fail "Radarr cannot authenticate to qBittorrent"
pass "Sonarr and Radarr are connected to qBittorrent with correct categories"

sonarr_media=$(curl -fsS -H "X-Api-Key: ${sonarr_key}" "http://{{ media_host_ip }}:{{ media_ports.sonarr }}/api/v3/config/mediamanagement")
radarr_media=$(curl -fsS -H "X-Api-Key: ${radarr_key}" "http://{{ media_host_ip }}:{{ media_ports.radarr }}/api/v3/config/mediamanagement")
python3 -c 'import json,sys; assert json.loads(sys.argv[1]).get("copyUsingHardlinks") is True' "${sonarr_media}" \
  || fail "Sonarr hardlink imports are disabled"
python3 -c 'import json,sys; assert json.loads(sys.argv[1]).get("copyUsingHardlinks") is True' "${radarr_media}" \
  || fail "Radarr hardlink imports are disabled"
pass "Sonarr and Radarr hardlink imports are enabled"

prowlarr_apps=$(curl -fsS -H "X-Api-Key: ${prowlarr_key}" "http://{{ media_host_ip }}:{{ media_ports.prowlarr }}/api/v1/applications")
python3 -c 'import json,sys; n={x["name"] for x in json.loads(sys.argv[1])}; assert {"Sonarr","Radarr"} <= n' "${prowlarr_apps}" \
  || fail "Prowlarr is missing Sonarr or Radarr integration"
pass "Prowlarr is integrated with Sonarr and Radarr"

docker exec prowlarr curl -fsS "http://flaresolverr:{{ media_flaresolverr_port }}/" >/dev/null \
  || fail "Prowlarr cannot reach FlareSolverr"
prowlarr_proxies=$(curl -fsS -H "X-Api-Key: ${prowlarr_key}" "http://{{ media_host_ip }}:{{ media_ports.prowlarr }}/api/v1/indexerProxy")
prowlarr_tags=$(curl -fsS -H "X-Api-Key: ${prowlarr_key}" "http://{{ media_host_ip }}:{{ media_ports.prowlarr }}/api/v1/tag")
python3 -c 'import json,sys; proxies=json.loads(sys.argv[1]); tags=json.loads(sys.argv[2]); tag=next(x for x in tags if x["label"]==sys.argv[3]); proxy=next(x for x in proxies if x["name"]=="FlareSolverr"); assert tag["id"] in proxy["tags"]' "${prowlarr_proxies}" "${prowlarr_tags}" "{{ media_flaresolverr_tag }}" \
  || fail "Prowlarr FlareSolverr proxy or tag is missing"
pass "Prowlarr is connected to FlareSolverr with a scoped tag"

grep -Eq '^  use_sonarr: true$' {{ media_stack_config_dir | quote }}/bazarr/config/config.yaml \
  || fail "Bazarr Sonarr integration is disabled"
grep -Eq '^  use_radarr: true$' {{ media_stack_config_dir | quote }}/bazarr/config/config.yaml \
  || fail "Bazarr Radarr integration is disabled"
pass "Bazarr is integrated with Sonarr and Radarr"

seerr_public=$(curl -fsS "http://{{ media_host_ip }}:{{ media_ports.seerr }}/api/v1/settings/public")
python3 -c 'import json,sys; assert json.loads(sys.argv[1]).get("initialized") is True' "${seerr_public}" \
  || fail "Seerr setup is not complete"
pass "Seerr setup and integrations are initialized"

jellyfin_auth_payload=$(python3 -c 'import json,sys; print(json.dumps({"Username":sys.argv[1],"Pw":sys.argv[2]}))' "${JELLYFIN_ADMIN_USER}" "${JELLYFIN_ADMIN_PASSWORD}")
jellyfin_auth=$(curl -fsS -X POST \
  -H 'Content-Type: application/json' \
  -H 'Authorization: MediaBrowser Client="media-verify", Device="jelly-01", DeviceId="media-verify", Version="1.0"' \
  --data "${jellyfin_auth_payload}" \
  "http://{{ media_host_ip }}:{{ media_ports.jellyfin }}/Users/AuthenticateByName")
jellyfin_token=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["AccessToken"])' "${jellyfin_auth}")
jellyfin_libraries=$(curl -fsS -H "X-Emby-Token: ${jellyfin_token}" "http://{{ media_host_ip }}:{{ media_ports.jellyfin }}/Library/VirtualFolders")
python3 -c 'import json,sys; p={path for lib in json.loads(sys.argv[1]) for path in lib.get("Locations",[])}; assert {"/data/media/movies","/data/media/tv"} <= p' "${jellyfin_libraries}" \
  || fail "Jellyfin media libraries are incomplete"
python3 -c 'import json,sys; libs=json.loads(sys.argv[1]); selected=[x for x in libs if {"/data/media/movies","/data/media/tv"} & set(x.get("Locations",[]))]; assert len(selected)==2 and all(x.get("LibraryOptions",{}).get("EnableRealtimeMonitor") is True for x in selected)' "${jellyfin_libraries}" \
  || fail "Jellyfin real-time library monitoring is disabled"
pass "Jellyfin detects Movies and TV libraries"

{% if media_jellyfin_qsv_available | default(false) %}
docker exec jellyfin test -c /dev/dri/renderD128 \
  || fail "Jellyfin cannot access the Intel render device"
docker exec jellyfin /usr/lib/jellyfin-ffmpeg/vainfo \
  --display drm --device /dev/dri/renderD128 >/dev/null 2>&1 \
  || fail "Jellyfin cannot initialize the Intel media driver"
grep -Eq '<HardwareAccelerationType>qsv</HardwareAccelerationType>' \
  {{ media_stack_config_dir | quote }}/jellyfin/config/encoding.xml \
  || fail "Jellyfin Quick Sync acceleration is disabled"
pass "Jellyfin can use Intel Quick Sync"
{% endif %}

docker compose restart >/dev/null
for container in "${containers[@]}"; do
  wait_for_health "${container}" || fail "container ${container} failed after Compose restart"
done
wait_for_qbittorrent_api || fail "qBittorrent API failed after Compose restart"
pass "all containers recover after a full stack restart"
