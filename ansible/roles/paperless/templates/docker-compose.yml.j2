---
services:
  broker:
    image: "{{ paperless_redis_image }}"
    restart: unless-stopped
    volumes:
      - "{{ paperless_data_root }}/redis:/data"

  db:
    image: "{{ paperless_postgres_image }}"
    restart: unless-stopped
    volumes:
      - "{{ paperless_data_root }}/pgdata:/var/lib/postgresql/data"
    environment:
      POSTGRES_DB: paperless
      POSTGRES_USER: paperless
      POSTGRES_PASSWORD: "{{ vault_paperless_db_password }}"

  gotenberg:
    image: "{{ paperless_gotenberg_image }}"
    restart: unless-stopped
    command:
      - gotenberg
      - --chromium-disable-routes=true

  tika:
    image: "{{ paperless_tika_image }}"
    restart: unless-stopped

  webserver:
    image: "{{ paperless_image }}"
    restart: unless-stopped
    depends_on:
      - db
      - broker
      - gotenberg
      - tika
    ports:
      - "{{ paperless_port }}:8000"
    volumes:
      - "{{ paperless_data_root }}/data:/usr/src/paperless/data"
      - "{{ paperless_data_root }}/media:/usr/src/paperless/media"
      - "{{ paperless_data_root }}/consume:/usr/src/paperless/consume"
      - "{{ paperless_data_root }}/export:/usr/src/paperless/export"
    environment:
      PAPERLESS_REDIS: redis://broker:6379
      PAPERLESS_DBHOST: db
      PAPERLESS_DBUSER: paperless
      PAPERLESS_DBPASS: "{{ vault_paperless_db_password }}"
      PAPERLESS_SECRET_KEY: "{{ vault_paperless_secret_key }}"
      PAPERLESS_TIME_ZONE: "{{ homelab_timezone }}"
      PAPERLESS_OCR_LANGUAGE: pol+eng
      PAPERLESS_OCR_LANGUAGES: pol
      PAPERLESS_URL: "http://paperless.{{ homelab_domain }}"
