proxmox_endpoint             = "https://192.168.60.10:8006/"
proxmox_api_token            = "terraform-prov@pve!terraform=REPLACE-ME"
proxmox_node                 = "pve"
proxmox_ssh_username         = "root"
proxmox_ssh_private_key_file = "~/.ssh/id_ed25519"
template_id                  = 9000
ssh_public_key               = "ssh-ed25519 AAAA... user@host"

# --- Optional (defaults shown) ---
network_cidr    = "192.168.60.0/24"
network_gateway = "192.168.60.1"
dns_servers     = ["192.168.60.1", "1.1.1.1"]
search_domain   = "lab"

# Home Assistant OS is pinned only for first provisioning. Update a running
# installation from the Home Assistant UI, not by changing this value.
home_assistant_os_version = "18.2"

# Optional stable Proxmox USB resource mappings, e.g. ["zigbee-coordinator"].
home_assistant_usb_mappings = []
