#cloud-config
hostname: ${hostname}
manage_etc_hosts: true

users:
  - default
  - name: ${username}
    groups:
      - wheel
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
packages:
  - ca-certificates
  - curl

runcmd:
  - |
      set -euo pipefail
      puppet_package_url='${puppet_agent_package_url}'
      puppet_server='${puppet_server}'
      puppet_certname='${hostname}'
      dns_servers='${dns_servers}'

      # Disable a previously installed Puppet Core repo when this VM is
      # reprovisioned without Core credentials. The package URL remains
      # pinned and is verified by DNF using Puppet's signing key.
      if [ -f /etc/yum.repos.d/puppet9-release.repo ]; then
        sed -i 's/^enabled=1/enabled=0/' /etc/yum.repos.d/puppet9-release.repo
      fi

      curl --fail --silent --show-error --location \
        https://yum.puppet.com/RPM-GPG-KEY-puppet | rpm --import -
      dnf --assumeyes --setopt=install_weak_deps=False \
        --disablerepo=puppet9 install "$puppet_package_url"

      nmcli connection modify "cloud-init eth0" \
        ipv4.dns "$dns_servers" ipv4.ignore-auto-dns yes
      nmcli connection up "cloud-init eth0"

      install -d -m 0755 /etc/puppetlabs/puppet
      cat > /etc/puppetlabs/puppet/puppet.conf <<EOF
      [main]
      server=$puppet_server
      certname=$puppet_certname
      environment=production
      EOF

      systemctl enable puppet
      systemctl start puppet
      touch /var/lib/puppet-agent-bootstrap.done
